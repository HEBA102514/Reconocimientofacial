<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLogin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true"
    tools:context=".vista.LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Encabezado -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#0D47A1"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="14dp"
            android:text="@string/subtitulo_curso"
            android:textColor="#455A64"
            android:textSize="12sp" />

        <!-- Tarjeta 1: Identificacion y Acceso Biometrico 1:1 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Identificación y Acceso Biométrico 1:1"
                    android:textColor="#1A237E"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Verificación contra las 3 poses cifradas (AES) con prueba de vida activa"
                    android:textColor="#546E7A"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtEstadoRegistroLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#E3F2FD"
                    android:padding="10dp"
                    android:textColor="#0D47A1"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtUsuarioLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:autofillHints="username"
                    android:backgroundTint="#546E7A"
                    android:hint="@string/hint_usuario"
                    android:inputType="text"
                    android:minHeight="48dp"
                    android:textColor="#263238"
                    android:textColorHint="#78909C"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Validador biométrico:"
                    android:textColor="#263238"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/radioGroupValidadorLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/radioValidadorEstandarLogin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="#0D47A1"
                        android:checked="true"
                        android:text="Estándar (0.65)"
                        android:textColor="#263238"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/radioValidadorEstrictoLogin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="#0D47A1"
                        android:text="Estricto (0.83)"
                        android:textColor="#263238"
                        android:textSize="12sp" />
                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Iluminación (CSV experimental):"
                    android:textColor="#263238"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/radioGroupLuzLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/radioLuzBuenaLogin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="#0D47A1"
                        android:checked="true"
                        android:text="Buena"
                        android:textColor="#263238"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/radioLuzBajaLogin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="#0D47A1"
                        android:text="Baja"
                        android:textColor="#263238"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/radioLuzContraluzLogin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="#0D47A1"
                        android:text="Contraluz"
                        android:textColor="#263238"
                        android:textSize="12sp" />
                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tipo de prueba (CSV experimental):"
                    android:textColor="#263238"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/radioGroupIntentoLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/radioIntentoGenuinoLogin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="#0D47A1"
                        android:checked="true"
                        android:text="Genuino"
                        android:textColor="#263238"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/radioIntentoImpostorLogin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="#0D47A1"
                        android:text="Impostor"
                        android:textColor="#263238"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/radioIntentoSpoofingLogin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="#0D47A1"
                        android:text="Spoofing"
                        android:textColor="#263238"
                        android:textSize="12sp" />
                </RadioGroup>

                <Button
                    android:id="@+id/btnIniciarBiometria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#0D47A1"
                    android:paddingVertical="12dp"
                    android:text="Iniciar sesión con Rostro (Liveness + 1:1)"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtMensajeLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#C62828"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tarjeta 2: Respaldo por Contrasena -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2. Respaldo por Contraseña · Rúbrica #1"
                    android:textColor="#1A237E"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Acceso alternativo validado con hash SHA-256 sobre el usuario ingresado"
                    android:textColor="#78909C"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/edtClaveLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:autofillHints="password"
                    android:backgroundTint="#546E7A"
                    android:hint="@string/hint_clave"
                    android:inputType="textPassword"
                    android:minHeight="48dp"
                    android:textColor="#263238"
                    android:textColorHint="#78909C"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnIniciarSesion"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingVertical="10dp"
                    android:text="Iniciar sesión con Contraseña"
                    android:textColor="#0D47A1"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:strokeColor="#0D47A1" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Acciones Inferiores -->
        <Button
            android:id="@+id/btnIrARegistro"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Registrar usuario (Consentimiento + Liveness + 3 Poses)"
            android:textColor="#1A237E"
            android:textSize="13sp"
            app:strokeColor="#90CAF9" />

        <Button
            android:id="@+id/btnVerCsvLogin"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Ver / Compartir Telemetría CSV"
            android:textColor="#263238"
            android:textSize="13sp"
            app:strokeColor="#B0BEC5" />
    </LinearLayout>
</ScrollView>
